{
  "executable": "DndCompanion.Host",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "dnd-companion",
  "author": "Grant Watson",
  "singleInstance": true,
  "build": {
    "appId": "com.grantwatson.dndcompanion",
    "productName": "DnD Companion",
    "copyright": "Copyright © 2026 Grant Watson",
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": [ "**/*" ]
      }
    ],
    "files": [
      {
        "from": "./ElectronHostHook/node_modules",
        "to": "ElectronHostHook/node_modules",
        "filter": [ "**/*" ]
      },
      "**/*"
    ]
  }
}
