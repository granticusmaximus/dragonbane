@* A single rolled die, rendered as a real polyhedral shape (not just a colored number badge).
   Shape is chosen by Sides — the standard D&D dice get a distinct silhouette; anything else
   (homebrew d3/d30/etc.) falls back to a plain circle. *@
<div class="die-face @CssClass">
    <svg viewBox="0 0 40 40" class="die-face__svg">
        @Shape
        <text x="20" y="25" text-anchor="middle" class="die-face__value">@Value</text>
    </svg>
</div>

@code {
    [Parameter] public int Sides { get; set; }
    [Parameter] public int Value { get; set; }
    [Parameter] public string? CssClass { get; set; }

    // Fixed, non-user-controlled SVG snippets keyed by die size — safe to render as MarkupString.
    private MarkupString Shape => new(Sides switch
    {
        4 => """<polygon points="20,4 36,34 4,34" />""",
        6 => """<rect x="6" y="6" width="28" height="28" rx="4" />""",
        8 => """<polygon points="20,3 37,20 20,37 3,20" />""",
        10 => """<polygon points="20,1 30,14 26,38 14,38 10,14" />""",
        12 => """<polygon points="20,4 37,17 31,36 9,36 3,17" />""",
        20 => """<polygon points="20,2 35,11 35,29 20,38 5,29 5,11" />""",
        100 => """<polygon points="20,1 30,14 26,38 14,38 10,14" />""",
        _ => """<circle cx="20" cy="20" r="18" />"""
    });
}
